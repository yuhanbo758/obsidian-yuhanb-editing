{
	"name": "obsidian-yuhanbo-editing",
	"version": "1.1.3",
	"description": "Independent Chinese and Markdown editing tools for Obsidian.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"test": "tsx --test tests/*.test.ts",
		"package": "npm run build && node scripts/package.mjs",
		"version": "node scripts/prepare-release.mjs --from-package && git add manifest.json versions.json package-lock.json"
	},
	"license": "MIT",
	"dependencies": {
		"opencc-js": "1.4.2"
	},
	"devDependencies": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "0.6.0",
		"globals": "^17.6.0",
		"happy-dom": "21.0.4",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"tsx": "^4.20.6",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"overrides": {
		"eslint-plugin-n": "17.24.0"
	}
}
